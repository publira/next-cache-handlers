{
  "name": "Publira Next Cache Handlers",
  "dockerComposeFile": ["../compose.yaml", "compose.yaml"],
  "service": "app",
  "workspaceFolder": "/workspaces/${localWorkspaceFolderBasename}",
  "features": {
    "ghcr.io/devcontainers/features/docker-in-docker:4.1.1": {
      "moby": false,
      "version": "29.3.1"
    },
    "ghcr.io/anthropics/devcontainer-features/claude-code:1.0.5": {},
    "ghcr.io/devcontainers/features/github-cli:1.1.3": {}
  },
  "customizations": {
    "vscode": {
      "extensions": [
        "esbenp.prettier-vscode",
        "oxc.oxc-vscode",
        "TypeScriptTeam.native-preview"
      ]
    }
  },
  "postCreateCommand": ".devcontainer/post-create.sh"
}
