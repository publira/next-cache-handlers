{
  "name": "@publira/next-cache-handlers",
  "version": "1.0.0",
  "description": "Redis-backed Next.js cacheHandler and cacheHandlers for self-hosted, multi-instance deployments.",
  "keywords": [
    "cache",
    "cache-handler",
    "nextjs",
    "redis",
    "valkey"
  ],
  "homepage": "https://github.com/publira/next-cache-handlers#readme",
  "bugs": "https://github.com/publira/next-cache-handlers/issues",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/publira/next-cache-handlers.git",
    "directory": "packages/next-cache-handlers"
  },
  "files": [
    "dist",
    "README.md"
  ],
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.mts",
      "default": "./dist/index.mjs"
    },
    "./incremental": {
      "types": "./dist/incremental.d.mts",
      "default": "./dist/incremental.mjs"
    },
    "./use-cache": {
      "types": "./dist/use-cache.d.mts",
      "default": "./dist/use-cache.mjs"
    },
    "./revalidate": {
      "types": "./dist/revalidate.d.mts",
      "default": "./dist/revalidate.mjs"
    },
    "./tags": {
      "types": "./dist/tags.d.mts",
      "default": "./dist/tags.mjs"
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "tsdown",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "redis": "6.2.1",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@types/node": "24.13.6",
    "next": "16.3.6",
    "tsdown": "0.23.0",
    "typescript": "6.0.3",
    "vitest": "5.0.1"
  },
  "peerDependencies": {
    "next": "^16.3.0"
  }
}
