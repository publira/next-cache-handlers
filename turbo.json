{
  "$schema": "https://turbo.build/schema.json",
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": ["dist/**", ".next/**", "!.next/cache/**"]
    },
    "dev": {
      "dependsOn": ["^build"],
      "cache": false,
      "persistent": true,
      "passThroughEnv": ["PNCH_*"]
    },
    "test": {
      "dependsOn": ["^build"],
      "env": ["PNCH_REDIS_URL"],
      "outputs": []
    },
    "test:e2e": {
      "dependsOn": ["^build"],
      "cache": false,
      "env": ["PNCH_REDIS_URL", "E2E_*"],
      "outputs": []
    },
    "typegen": {
      "dependsOn": ["^build"],
      "outputs": [".next/types/**"]
    },
    "typecheck": {
      "dependsOn": ["typegen", "^typecheck"],
      "outputs": []
    }
  }
}
